# ============================================================
# Telegram Bot Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# Telegram Bot token from @BotFather
TOKEN=123456:ABC-DEF_your_bot_token

# Public HTTPS base URL of this service (Koyeb app URL, no trailing slash)
SERVER_URL=https://your-app.koyeb.app

# Your personal Telegram chat ID (admin only)
ADMIN_CHAT_ID=407527693

# HTTP port (Koyeb sets PORT automatically; default 5000 for local)
PORT=5000

# Supabase project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase service role key (server-side only — never expose to clients)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Channel the bot administers (numeric id like -100xxxxxxxxxx or @channelusername)
CHANNEL_ID=-1001234567890

# Public invite link shown to users (optional but recommended)
CHANNEL_INVITE_LINK=https://t.me/your_channel

# Bot username without @
BOT_USERNAME=MY_BOT

# Optional
NODE_ENV=production
LOG_LEVEL=info
